# Copia este archivo a .env.local y rellénalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional en local. En producción, la URL pública (p. ej. https://rotafy.es)
# para que los enlaces de WhatsApp y de los emails apunten bien.
# NEXT_PUBLIC_SITE_URL=https://rotafy.es

# SOLO en el servidor. Nunca la uses en código del navegador ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Opcional: muestra "Continuar con Google" en /login. Ponlo a 1 solo después de
# activar Google en Supabase (Authentication → Sign In / Providers → Google).
# NEXT_PUBLIC_AUTH_GOOGLE=1

# Opcional: avisos en el móvil (Web Push, gratis). Genera las claves UNA vez con
#   npx web-push generate-vapid-keys
# La pública puede verse en el navegador; la privada es SECRETA (como la service role key).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hola@rotafy.es

# Opcional: email de soporte que aparece en el panel de Ayuda de la app.
# NEXT_PUBLIC_SUPPORT_EMAIL=hola@rotafy.es

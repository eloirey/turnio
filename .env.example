# Copia este archivo a .env.local y rellénalo con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Opcional en local. En producción, la URL pública (p. ej. https://rotafy.es)
# para que los enlaces de WhatsApp y de los emails apunten bien.
# NEXT_PUBLIC_SITE_URL=https://rotafy.es

# SOLO en el servidor. Nunca la uses en código del navegador ni la subas a GitHub.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
